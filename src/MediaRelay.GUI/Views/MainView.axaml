<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MediaRelay.GUI.ViewModels"
             xmlns:pages="using:MediaRelay.GUI.Views.Pages"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="MediaRelay.GUI.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#f5f5f5">

    <UserControl.DataContext>
        <vm:MainViewModel />
    </UserControl.DataContext>

    <TabControl>
        <TabItem Header="任务">
            <pages:MessagePage DataContext="{Binding MessagePage}"></pages:MessagePage>
        </TabItem>

        <TabItem Header="缓存">

        </TabItem>

        <TabItem Header="设置">

        </TabItem>

    </TabControl>

</UserControl>
