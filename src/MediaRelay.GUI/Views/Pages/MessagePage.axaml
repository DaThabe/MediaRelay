<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MediaRelay.GUI.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
             x:DataType="vm:MessagePageViewModel"
             x:Class="MediaRelay.GUI.Views.Pages.MessagePage">

    <UserControl.DataContext>
        <vm:MessagePageViewModel />
    </UserControl.DataContext>

    <UserControl.DataTemplates>

        <DataTemplate DataType="vm:MessageViewModel">
            <Border Padding="20" CornerRadius="15" Background="#FFF">
                <DockPanel>

                    <!--顶部栏-->
                    <DockPanel VerticalAlignment="Center" DockPanel.Dock="Top">

                        <StackPanel Spacing="5" DockPanel.Dock="Right" Orientation="Horizontal">

                            <Button Content="重试"></Button>
                            <Button Content="删除"></Button>

                        </StackPanel>

                        <TextBlock VerticalAlignment="Center" Text="{Binding SourceId}"></TextBlock>

                    </DockPanel>

                    <Separator DockPanel.Dock="Top" Margin="0 10"></Separator>

                    <!--标题-->
                    <TextBlock FontWeight="Bold" FontSize="20" Opacity="0.8" DockPanel.Dock="Top" Text="{Binding Info.Title}"></TextBlock>
                    <!--描述-->
                    <TextBlock Margin="5" FontSize="12" Opacity="0.5" DockPanel.Dock="Top" Text="{Binding Info.Description}" TextWrapping="Wrap"></TextBlock>
                    <!--标签-->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Info.Tags}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="AliceBlue" Padding="5 3" Margin="2" CornerRadius="5" ClipToBounds="True">
                                    <TextBlock Text="{Binding}" />
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"></WrapPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!--底部栏-->
                    <DockPanel DockPanel.Dock="Bottom">

                        <TextBlock DockPanel.Dock="Right" Text="{Binding CreateAt, StringFormat=HH:mm}"></TextBlock>
                        <TextBlock Text="{Binding InputType}"></TextBlock>

                    </DockPanel>

                    <!--图像-->
                    <ItemsControl Margin="0 10" ItemsSource="{Binding Info.Resources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                                    <Border Height="80"  Margin="2" CornerRadius="5" ClipToBounds="True">
                                        <ContentControl Content="{Binding}" />
                                    </Border>
                                </ScrollViewer>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"></StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>


                </DockPanel>
            </Border>
        </DataTemplate>

    </UserControl.DataTemplates>

    <ItemsControl ItemsSource="{Binding ItemsSource}">

        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"></StackPanel>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

    </ItemsControl>

</UserControl>
