<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pagesVm="using:MediaRelay.Desktop.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MediaRelay.GUI.Views.Pages.MessagePage">
    <UserControl.DataTemplates>

        <DataTemplate DataType="pagesVm:MessageViewModel">
            <Border Padding="20" CornerRadius="15" Background="#FFF">
                <DockPanel>

                    <!--顶部栏-->
                    <DockPanel VerticalAlignment="Center" DockPanel.Dock="Top">

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">

                            <Button Content="重试"></Button>

                        </StackPanel>

                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding SourceId}"></TextBlock>

                    </DockPanel>

                    <!--底部栏-->
                    <DockPanel DockPanel.Dock="Bottom">

                        <TextBlock DockPanel.Dock="Right" Text="{Binding CreateAt, StringFormat=HH:mm}"></TextBlock>
                        <TextBlock Text="{Binding InputType}"></TextBlock>

                    </DockPanel>

                    <!--内容栏-->
                    <Expander Background="Transparent" IsExpanded="True" Padding="5" Margin="0 10" HorizontalAlignment="Stretch">

                        <Expander.Header>
                            <DockPanel>
                                <TextBlock FontWeight="Medium" DockPanel.Dock="Top" Text="{Binding Info.Title}"></TextBlock>
                                <TextBlock Text="{Binding Info.Description}"></TextBlock>
                            </DockPanel>
                        </Expander.Header>

                        <ItemsControl ItemsSource="{Binding Info.Resources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                                        <Border Height="60"  Margin="2" CornerRadius="5" ClipToBounds="True">
                                            <Image Source="{Binding}" />
                                        </Border>
                                    </ScrollViewer>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"></StackPanel>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                    </Expander>


                </DockPanel>
            </Border>
        </DataTemplate>

    </UserControl.DataTemplates>


    Welcome to Avalonia!
</UserControl>
