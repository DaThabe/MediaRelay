{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "MediaRelay": "Trace"
    }
  },
  "MediaRelay": {
    "Http": {
      "IgnoreSslErrors": true,
      "Timeout": "00:03:00",
      "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/152.0.0.0 Safari/537.36"
    },

    "Browser": {
      "Launch": {
        "ExecutablePath": "./Browser/chrome-win64/chrome.exe",
        "Headless": false,
        "Timeout": "00:01:00",
        "Args": [
          "--no-sandbox",
          "--disable-dev-shm-usage",
          "--disable-setuid-sandbox"
        ],
        "DownloadsPath": "./Browser/Downloads"
      },
      "NewContext": {
        "ViewportSize": {
          "Width": 1920,
          "Height": 1080
        }
      }
    },
    "Clipboard": {
      "PollingInterval": "00:00:00.500"
    },
    "Storage": {
      "RootPath": "./Storage"
    },

    "Immich": {
      "BaseUrl": "http://localhost:2283/api",
      "ApiKey": "YOUR_VALUE"
    },

    "Url": {
      "MessageQueue": {
        "File": "UrlMessages.json",
        "MessageRetryCount": 5
      }
    },
    "Pixiv": {
      "Http": {
        "BaseUrl": "https://www.pixiv.net/",
        "Referrer": "https://www.pixiv.net/",
        "MaxConcurrentDownloads": 3,
        "Cookies": [
          {
            "name": "PHPSESSID",
            "value": "YOUR_VALUE",
            "domain": ".pixiv.net",
            "path": "/",
            "httpOnly": true,
            "secure": true
          }
        ]
      },
      "OriginalImageUrl": {
        "Format": "https://i.pximg.net/img-original/img/{0:D4}/{1:D2}/{2:D2}/{3:D2}/{4:D2}/{5:D2}/{6}{7}_p{8}.{9}",
        "Pattern": "i\\.pximg\\.net/img-original/img/(?<yyyy>\\d{4})/(?<MM>\\d{2})/(?<dd>\\d{2})/(?<HH>\\d{2})/(?<mm>\\d{2})/(?<ss>\\d{2})/(?<pid>\\d+)(-(?<hash>[a-zA-Z0-9]+)){0,1}_p(?<idx>\\d+)\\.(?<ext>\\w+)",
        "ArtworkIdKey": "pid",
        "HashKey": "hash",
        "IndexKey": "idx",
        "ExtensionsKey": "ext",
        "YearKey": "yyyy",
        "MonthKey": "MM",
        "DayKey": "dd",
        "HourKey": "HH",
        "MinuteKey": "mm",
        "SecondKey": "ss"
      },
      "Artwork": {
        "Url": {
          "Format": "https://www.pixiv.net/artworks/{0}",
          "Pattern": "pixiv\\.net/artworks/(?<pid>\\d+)",
          "ArtworkIdKey": "pid"
        },
        "ExtractScriptPath": "Browser/Scripts/PixivArtwork.js"
      }
    },
    "Twitter": {
      "Http": {
        "MaxConcurrentDownloads": 3,
        "Cookies": [
          {
            "Name": "auth_token",
            "Value": "YOUR_VALUE",
            "Domain": "x.com",
            "Path": "/",
            "HttpOnly": true,
            "Secure": true
          }
        ]
      },
      "ImageUrl": {
        "Format": "https://pbs.twimg.com/media/{0}?format={1}&name={2}",
        "Pattern": "pbs\\.twimg\\.com/media/(?<mid>[A-Za-z0-9\\-_]+)\\?*(?:format=(?<fmt>[^&]+)&?|name=(?<size>[^&]+)&?)*",
        "MediaIdKey": "mid",
        "FormatKey": "fmt",
        "SizeKey": "size"
      },
      "Tweet": {
        "Url": {
          "Format": "https://x.com/{0}/status/{1}",
          "Pattern": "x\\.com/(?<uid>\\w+)/status/(?<tid>\\w+)\\?*",
          "UsernameKey": "uid",
          "TweetIdKey": "tid"
        },
        "ExtractScriptPath": "Browser/Scripts/TwitterTweet.js"
      }
    },
    "HeyBox": {
      "Http": {
        "MaxConcurrentDownloads": 3,
        "Cookies": [
          {
            "Name": "user_heybox_id",
            "Value": "YOUR_VALUE",
            "Domain": ".xiaoheihe.cn",
            "Path": "/",
            "HttpOnly": true,
            "Secure": true
          },
          {
            "Name": "user_device_id",
            "Value": "YOUR_VALUE",
            "Domain": ".xiaoheihe.cn",
            "Path": "/",
            "HttpOnly": true,
            "Secure": true
          },
          {
            "Name": "user_pkey",
            "Value": "YOUR_VALUE",
            "Domain": ".xiaoheihe.cn",
            "Path": "/",
            "HttpOnly": true,
            "Secure": true
          },
          {
            "Name": "x_xhh_tokenid",
            "Value": "YOUR_VALUE",
            "Domain": ".xiaoheihe.cn",
            "Path": "/",
            "HttpOnly": true,
            "Secure": true
          }
        ]
      },
      "OriginalImageUrl": {
        "Format": "https://imgheybox1.max-c.com/bbs/{0:D4}/{1:D2}/{2:D2}/{3}.{4}",
        "Pattern": "imgheybox1\\.max-c\\.com/bbs/(?<yyyy>\\d{4})/(?<MM>\\d{2})/(?<dd>\\d{2})/(?<hash>[a-zA-Z0-9]+)\\.(?<ext>\\w+)",
        "YearKey": "yyyy",
        "MonthKey": "MM",
        "DayKey": "dd",
        "HashKey": "hash",
        "ExtensionsKey": "ext"
      },
      "BbsLink": {
        "Url": {
          "Format": "https://www.xiaoheihe.cn/app/bbs/link/{0}",
          "Pattern": "xiaoheihe\\.cn/app/bbs/link/(?<id>\\d+)",
          "ArtworkIdKey": "id"
        },
        "ExtractScriptPath": "Browser/Scripts/HeyBoxBbsLink.js"
      }
    }
  }
}